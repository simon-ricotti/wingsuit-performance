# Copy to .env.local (not committed) and fill in from the Supabase project:
# Project Settings → API Keys. On Vercel, set them in Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Never with the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
